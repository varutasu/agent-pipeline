# Forbidden patterns gate (optional L3)
#
# Source: skills/bootstrap-agent-context/templates/L3-pipeline/_common/forbidden-patterns.yml.template
# Install to: .github/workflows/forbidden-patterns.yml
#
# Repo-specific security/style policies enforced by grep in CI.
# Harvested from stwl-labs/tcg-vault (9-check job). This template ships a
# minimal starter; extend CHECKS below for your repo.
#
# Bypass: add label `skip-forbidden-patterns` (rare — document in PR body).

name: Forbidden patterns

on:
  pull_request:
    branches: [main, develop]
    types: [opened, synchronize, reopened, labeled, unlabeled]

permissions:
  contents: read

jobs:
  patterns:
    name: Forbidden patterns
    runs-on: ubuntu-latest
    steps:
      - name: Skip — bypass label
        id: bypass
        uses: actions/github-script@v7
        with:
          script: |
            const labels = (context.payload.pull_request?.labels || []).map(l => l.name);
            core.setOutput('skip', labels.includes('skip-forbidden-patterns') ? 'true' : 'false');

      - name: Checkout
        if: steps.bypass.outputs.skip != 'true'
        uses: actions/checkout@v4

      - name: Run pattern checks
        if: steps.bypass.outputs.skip != 'true'
        run: |
          set -euo pipefail
          FAIL=0

          echo "::group::Check 1/N: Hardcoded secret patterns"
          if git grep -nE '(api[_-]?key|secret|password)\s*=\s*["\x27][^"\x27]{8,}' -- ':!node_modules' ':!.git' 2>/dev/null; then
            echo "::error::Possible hardcoded secret — use environment variables."
            FAIL=1
          else
            echo "OK"
          fi
          echo "::endgroup::"

          echo "::group::Check 2/N: Dangerous DOM / eval"
          if git grep -nE 'dangerouslySetInnerHTML|eval\(' -- '*.ts' '*.tsx' '*.js' '*.jsx' 2>/dev/null | grep -v '// security-audit:allowed'; then
            echo "::warning::dangerouslySetInnerHTML or eval found — verify sanitization or add // security-audit:allowed with justification."
          fi
          echo "::endgroup::"

          # --- Add repo-specific checks below (copy from tcg-vault forbidden-patterns job) ---
          # echo "::group::Check 3/N: No dev endpoints in pages/api"
          # ...

          if [ "$FAIL" -ne 0 ]; then
            echo "::error::Forbidden patterns gate failed."
            exit 1
          fi
          echo "::notice::Forbidden patterns gate passed."
