# npm audit gate (optional L3)
#
# Source: skills/bootstrap-agent-context/templates/L3-pipeline/_common/npm-audit-gate.yml.template
# Install to: .github/workflows/npm-audit-gate.yml
#
# Fails PRs that introduce or retain high/critical npm audit findings.
# Pair with security-audit skill layer 5. Bypass: label `skip-npm-audit`.

name: npm audit gate

on:
  pull_request:
    branches: [main, develop]
    types: [opened, synchronize, reopened, labeled, unlabeled]

permissions:
  contents: read

jobs:
  audit:
    name: npm audit (high+)
    runs-on: ubuntu-latest
    steps:
      - name: Skip — bypass label
        id: bypass
        uses: actions/github-script@v7
        with:
          script: |
            const labels = (context.payload.pull_request?.labels || []).map(l => l.name);
            core.setOutput('skip', labels.includes('skip-npm-audit') ? 'true' : 'false');

      - name: Checkout
        if: steps.bypass.outputs.skip != 'true'
        uses: actions/checkout@v4

      - name: Install + audit
        if: steps.bypass.outputs.skip != 'true'
        run: |
          set -euo pipefail
          if [ -f pnpm-lock.yaml ]; then
            corepack enable
            pnpm install --frozen-lockfile
            pnpm audit --audit-level=high
          elif [ -f package-lock.json ]; then
            npm ci
            npm audit --audit-level=high
          else
            echo "::warning::No lockfile found — skipping npm audit gate."
          fi
