name: CI

# Vercel variant: this CI does NOT run `npm run build`. Vercel builds the
# Preview deployment on every push and gates the PR via the Vercel GitHub
# integration check. Running our own build here would duplicate Vercel's
# work for ~3-5 minutes per PR with no added signal.
#
# What this CI DOES cover (and Vercel does not):
#   - Unit + integration tests against a Postgres service container
#   - Schema-map drift check (docs/SCHEMA_MAP.md regenerated cleanly)
#   - Lint + type-check (cheap belt-and-suspenders; Vercel preview build
#     would also catch these but ~2 min later)
#
# If you also want a fast lint/type-check signal independent of Vercel's
# build, keep the lint-types job. If you trust Vercel's build to surface
# them, you can delete that job too.

on:
  pull_request:
    branches: [develop, main]
  push:
    branches: [develop]

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  NODE_VERSION: '20'

jobs:
  lint-types:
    name: Lint + types
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm
      - run: npm ci
      - name: Generate Prisma client
        run: npx prisma generate
      - run: npm run lint
      - name: Type check
        run: npx tsc --noEmit

  test:
    name: Unit + integration tests
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: ci
          POSTGRES_PASSWORD: ci
          POSTGRES_DB: ci
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U ci"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm
      - run: npm ci
      - run: npx prisma generate
      - name: Run migrations
        run: npx prisma migrate deploy
        env:
          DATABASE_URL: postgresql://ci:ci@localhost:5432/ci
      - run: npm run test:run
        env:
          DATABASE_URL: postgresql://ci:ci@localhost:5432/ci
          NEXTAUTH_SECRET: ci-secret-only-for-tests
          NEXTAUTH_URL: http://localhost:3000

  schema-map-fresh:
    name: Schema map up to date
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm
      - run: npm ci
      - name: Regenerate schema map
        run: npm run schema:map
      - name: Verify no drift
        run: |
          if ! git diff --quiet docs/SCHEMA_MAP.md; then
            echo "::error::docs/SCHEMA_MAP.md is out of date. Run 'npm run schema:map' and commit."
            git diff docs/SCHEMA_MAP.md
            exit 1
          fi
