name: Preview smoke

# Vercel variant: waits for Vercel's per-PR Preview deployment to be ready,
# then runs Playwright smoke against its URL.
#
# Vercel's GitHub integration auto-deploys every push to its own infrastructure
# and posts a Deployment to the GitHub API once it's ready. We wait on that
# Deployment (rather than a guessed URL pattern) so we always hit the canonical
# preview URL Vercel just published.

on:
  pull_request:
    branches: [develop, main]
    types: [labeled, opened, synchronize, reopened]

concurrency:
  group: preview-smoke-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  gate:
    name: Should run?
    runs-on: ubuntu-latest
    outputs:
      should_run: ${{ steps.check.outputs.should_run }}
    steps:
      - name: Decide
        id: check
        run: |
          if echo "${{ github.event.pull_request.body }}" | grep -qE 'pipeline:.*skip.*\bsmoke\b'; then
            echo "should_run=false" >> $GITHUB_OUTPUT
            echo "::notice::Smoke skipped via pipeline directive"
          else
            echo "should_run=true" >> $GITHUB_OUTPUT
          fi

  smoke:
    name: Playwright smoke
    needs: gate
    if: needs.gate.outputs.should_run == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - name: Wait for Vercel Preview deployment
        id: vercel
        # Polls GitHub Deployments API for a Vercel deployment matching the PR's
        # head sha. Returns the deployment URL (e.g. https://my-app-abc123.vercel.app).
        # Pin to a tag for stability.
        uses: patrickedqvist/wait-for-vercel-preview@v1.3.2
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          max_timeout: 600
          # Optional: environment filter if your Vercel project has more than
          # one (e.g. if you deploy a docs site separately):
          # environment: Preview

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm

      - run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Run smoke tests
        run: npx playwright test --project=smoke
        env:
          BASE_URL: ${{ steps.vercel.outputs.url }}

      - name: Upload Playwright report on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 7
