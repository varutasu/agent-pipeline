# .agent-context-manifest.yml
#
# Generated by agent-pipeline. Tracks which artifacts the bootstrap skill
# installed in this repo, where they came from, and what version of the
# pipeline they correspond to.
#
# Read by `sync-agent-context` skill to detect drift and propose updates.
# Don't edit by hand — use the bootstrap or sync skill in Cursor.
#
# Schema: docs/manifest-schema.md (in the agent-pipeline repo)

schema_version: 1
pipeline_version: "<PIPELINE_VERSION>"
pipeline_source: "https://github.com/varutasu/agent-pipeline"
installed_at: "<ISO_TIMESTAMP>"
last_synced_at: "<ISO_TIMESTAMP>"

# Which layers the bootstrap skill installed. Matches the layer selection
# the user confirmed in Step 1.
layers:
  - L1
  - L2
  - L3

# Each artifact this manifest tracks.
#   path:           where the file lives in THIS repo (relative to repo root)
#   source:         the template path WITHIN the pipeline repo (relative to its root)
#   version:        pipeline version that installed/last-updated this artifact
#   installed_hash: sha256 of the file as installed; used to detect local edits.
#                   If the file's current hash != installed_hash, the user
#                   customized it locally and the sync skill MUST NOT silently
#                   overwrite it.
artifacts:
  - path: ".cursor/agents/role-conductor.md"
    source: "skills/bootstrap-agent-context/templates/L2-roles/role-conductor.md"
    version: "<PIPELINE_VERSION>"
    installed_hash: "sha256:<HASH>"
  # ... one entry per installed file. The bootstrap skill fills this in
  # based on what it actually wrote.
