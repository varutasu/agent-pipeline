# Runtime — PostgreSQL on CT 102 (create DB first; see DEPLOY.md)
DATABASE_URL=postgresql://pipeline_analytics:CHANGE_ME@192.168.68.102:5432/pipeline_analytics?schema=public

# Bearer token for POST /api/sync/* (generate: openssl rand -hex 32)
SYNC_TOKEN=

# GitHub sync — fine-grained or PAT with repo contents read on private consumers
GITHUB_TOKEN=
# Comma-separated owner/repo:branch (branch defaults to main)
SYNC_REPOS=stwl-labs/zest-finances:main,stwl-labs/deckhearth:main,rstillwell-trimb/colab:main
